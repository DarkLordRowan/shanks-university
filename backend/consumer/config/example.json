{
  "series": [
    {
      "name": "CosSeries",
      "args": {
        "x": [1, 2]
      }
    }
  ],
  "noises": [
    {
      "type": "Normal",
      "method": "jitter",
      "param1": 0.0,
      "param2": 1e-10,
      "seed": 42
    },
    {
      "type": "Uniform",
      "method": "scaling",
      "param1": 0.9999999999,
      "param2": 1.0000000001,
      "seed": 42
    }
  ],
  "filters": [
    {
      "type": "savgol",
      "params": {
        "polyorder": 2,
        "derive": 0,
        "delta": 1.0
      }
    },
    {
      "type": "kolzur",
      "params": {
        "degree": 3
      }
    }
  ],
  "methods": [
    {
      "name": "LevinAlgorithm",
      "n": {
        "start": 10,
        "stop": 12,
        "step": 1
      },
      "m": [8],
      "args": {
        "remainder": ["v_type"],
        "useRecurrentFormula": true
      },
      "events": [
        {
          "type": "slow_accel",
          "log_action_capacity": -1
        },
        {
          "type": "sign_changed",
          "log_action_capacity": -1
        },
        {
          "type": "monotone",
          "log_action_capacity": -1
        },
        {
          "type": "divergent_accel",
          "log_action_capacity": -1,
          "stop_action_limit": 3
        }
      ]
    },
    {
      "name": "RichardsonAlgorithm",
      "n": {
        "start": 10,
        "stop": 12,
        "step": 1
      },
      "m": [8],
      "args": {},
      "events": [
        {
          "type": "slow_accel",
          "log_action_capacity": -1
        },
        {
          "type": "sign_changed",
          "log_action_capacity": -1
        },
        {
          "type": "monotone",
          "log_action_capacity": -1
        },
        {
          "type": "divergent_accel",
          "log_action_capacity": -1,
          "stop_action_limit": 1
        }
      ]
    }
  ]
}
