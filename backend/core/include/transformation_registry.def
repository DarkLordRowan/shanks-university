// MACROS required:
// TRANSFORMATION_ENTRY(id, name, camel_name, class_name, binding_strategy, factory_body)

// Binding Strategies:
// BIND_DEFAULT: py::init<>()
// BIND_REM: py::init<remainder>()
// BIND_REM_BOOL: py::init<remainder, bool>()
// BIND_LEVIN_BASE: py::init<remainder, bool, RealT>()
// BIND_F_BASE: py::init<remainder>()
// BIND_PJ_BASE: py::init<remainder, int, RealT>()
// BIND_RHO: py::init<numerator, RealT, RealT>()
// BIND_NONE: Do not bind (used for duplicates or internal variants)

TRANSFORMATION_ENTRY(anderson_acceleration_algorithm_id, "Anderson's acceleration algorithm", "AndersonAccelerationAlgorithm", anderson_acceleration_algorithm, BIND_DEFAULT, { return std::make_unique<shanks::algos::anderson_acceleration_algorithm<T, K>>(); })
